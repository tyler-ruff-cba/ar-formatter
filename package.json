{
  "name": "ar-formatter",
  "version": "0.2.0",
  "description": "Electron app which trims and formats weekly 7 spreadsheets for the AR-Proc app",
  "keywords": [
    "ar",
    "accounts",
    "cba"
  ],
  "homepage": "https://github.com/tyler-ruff-cba/ar-formatter#readme",
  "bugs": {
    "url": "https://github.com/tyler-ruff-cba/ar-formatter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-ruff-cba/ar-formatter.git"
  },
  "license": "MIT",
  "author": "tyler-ruff-cba",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "dist": "electron-builder --x64",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "electron": "^42.3.3",
    "exceljs": "^4.4.0",
    "vite": "^8.0.16",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.cbautils.arformatter",

    "win": {
      "target": ["nsis"]
    },

    "mac": {
      "target": ["dmg"]
    },

    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
